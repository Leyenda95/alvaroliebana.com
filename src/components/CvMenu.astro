---
// Botón "CV": desplegable con el CV interactivo y el archivo PDF, que a su vez despliega los dos idiomas.
// Los colores los pone cada variante con las variables --menu-*. El cierre lo gestiona LandingLayout.
import T from './T.astro';
import { cvMenu, cvPdf } from '../data/landing.js';
const { class: className = '' } = Astro.props;
---
<details class:list={['cvmenu', className]}>
  <summary>CV <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="m2.5 4.5 3.5 3.5 3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
  <div class="cvmenu-list">
    <a href="/cv">
      <T class="cvmenu-t" t={cvMenu.interactive} />
      <T class="cvmenu-d" t={cvMenu.interactiveHint} />
    </a>
    <!-- Botón y no <details>: en iPhone, un <details> anidado conserva su altura al cerrarlo y deja un hueco en blanco -->
    <button type="button" class="cvmenu-row" aria-expanded="false">
      <span class="cvmenu-txt">
        <T class="cvmenu-t" t={cvMenu.pdf} />
        <T class="cvmenu-d" t={cvMenu.pdfHint} />
      </span>
      <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="m2.5 4.5 3.5 3.5 3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <div class="cvmenu-langs" hidden>
      <a href={cvPdf.es} hreflang="es" lang="es" target="_blank" rel="noopener">Español</a>
      <a href={cvPdf.en} hreflang="en" lang="en" target="_blank" rel="noopener">English</a>
    </div>
  </div>
</details>

<style is:global>
  /* Sin selección de texto: los clics rápidos en el botón CV seleccionaban todo el desplegable */
  .cvmenu { position:relative; display:inline-block; -webkit-user-select:none; user-select:none; }
  .cvmenu summary { list-style:none; cursor:pointer; display:inline-flex; align-items:center; gap:8px; }
  .cvmenu summary::-webkit-details-marker { display:none; }
  .cvmenu svg { flex:none; transition:transform .2s ease; }
  .cvmenu[open] > summary svg, .cvmenu-row[aria-expanded="true"] svg { transform:rotate(180deg); }
  .cvmenu-list { position:absolute; z-index:20; top:calc(100% + 8px); left:0; min-width:230px; display:flex; flex-direction:column; gap:2px; padding:6px; background:var(--menu-bg); color:var(--menu-ink); border:var(--menu-border); border-radius:var(--menu-radius, 12px); box-shadow:var(--menu-shadow); }
  .cvmenu-list a, .cvmenu-row { display:flex; flex-direction:column; gap:2px; padding:10px 12px; border-radius:calc(var(--menu-radius, 12px) - 4px); text-decoration:none; color:inherit; text-align:left; }
  .cvmenu.up .cvmenu-list { top:auto; bottom:calc(100% + 8px); } /* si no cabe debajo; lo decide LandingLayout */
  .cvmenu-list a:focus-visible, .cvmenu-row:focus-visible { background:var(--menu-hover); }
  /* Solo con ratón: en táctil el resaltado se queda pegado tras el toque y la fila parece abierta */
  @media (hover:hover) {
    .cvmenu-list a:hover, .cvmenu-row:hover:not(.quiet) { background:var(--menu-hover); }
  }
  .cvmenu-t { font-weight:600; font-size:15px; line-height:1.3; }
  .cvmenu-d { font-size:13px; line-height:1.3; opacity:.7; }
  .cvmenu-row { appearance:none; width:100%; border:0; background:none; font:inherit; cursor:pointer; flex-direction:row; align-items:center; justify-content:space-between; gap:12px; }
  .cvmenu-txt { display:flex; flex-direction:column; gap:2px; }
  .cvmenu-langs[hidden] { display:none; }
  .cvmenu-langs { display:grid; grid-template-columns:1fr 1fr; gap:2px; margin-top:2px; }
  .cvmenu-langs a { align-items:center; font-weight:600; font-size:15px; line-height:1.3; }
</style>
