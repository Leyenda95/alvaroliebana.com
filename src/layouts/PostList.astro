---
// Lista de artículos, del más reciente al más antiguo
interface Props { posts: any[]; lang: 'en' | 'es'; }
const { posts, lang } = Astro.props;
const sorted = [...posts].sort((a, b) => +new Date(b.frontmatter.date) - +new Date(a.frontmatter.date));
const fmt = new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const t = {
  en: { title: 'Blog', intro: 'Notes on privacy, blockchain and building products.', empty: 'No posts yet.' },
  es: { title: 'Blog', intro: 'Notas sobre privacidad, blockchain y creación de productos.', empty: 'Todavía no hay artículos.' },
}[lang];
---
<section>
  <h1>{t.title}</h1>
  <p class="intro">{t.intro}</p>
  {sorted.length === 0 && <p class="intro">{t.empty}</p>}
  <ul>
    {sorted.map((p) => (
      <li>
        <a href={p.url}>
          <time>{fmt.format(new Date(p.frontmatter.date))}</time>
          <span class="t">{p.frontmatter.title}</span>
          {p.frontmatter.description && <span class="d">{p.frontmatter.description}</span>}
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  h1 { font:800 clamp(44px,8vw,68px)/1 var(--f-display); letter-spacing:-.03em; margin:0; }
  .intro { color:var(--muted); margin:12px 0 0; }
  ul { list-style:none; padding:0; margin:32px 0 0; display:flex; flex-direction:column; border-top:2px solid var(--ink); }
  li { border-bottom:2px solid var(--ink); }
  li a { display:grid; grid-template-columns:110px minmax(0,1fr); gap:4px 20px; padding:20px 0; text-decoration:none; }
  time { font:400 13px/1.9 var(--f-mono); color:var(--muted); grid-row:span 2; }
  .t { font:700 22px/1.25 var(--f-display); letter-spacing:-.015em; }
  li a:hover .t { color:var(--accent); }
  .d { color:var(--muted); font-size:15.5px; line-height:1.55; }
  @media (max-width:560px) { li a { grid-template-columns:minmax(0,1fr); } time { grid-row:auto; } .t { font-size:20px; } }
</style>
