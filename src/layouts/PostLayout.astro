---
// Plantilla de cada artículo escrito en Markdown.
// Un artículo en /blog/x tiene su traducción en /es/blog/x (mismo nombre de archivo).
import BlogLayout from './BlogLayout.astro';

const { frontmatter } = Astro.props;
const lang: 'en' | 'es' = frontmatter.lang === 'es' ? 'es' : 'en';
const path = Astro.url.pathname.replace(/\/$/, '');
const altHref = lang === 'en' ? `/es${path}` : path.replace(/^\/es/, '');
const date = new Date(frontmatter.date);
const fmt = new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const back = lang === 'es' ? '← Todos los artículos' : '← All posts';
const backHref = lang === 'es' ? '/es/blog' : '/blog';
---
<BlogLayout title={`${frontmatter.title} · Álvaro Liébana`} description={frontmatter.description} lang={lang} altHref={altHref}>
  <article>
    <a class="back" href={backHref}>{back}</a>
    <h1>{frontmatter.title}</h1>
    <time datetime={date.toISOString()}>{fmt.format(date)}</time>
    <div class="prose"><slot /></div>
  </article>
</BlogLayout>

<style>
  article { display:flex; flex-direction:column; gap:12px; }
  .back { font:500 13px/1 var(--f-mono); color:var(--muted); text-decoration:none; }
  .back:hover { color:var(--ink); }
  h1 { font:600 clamp(30px,5vw,42px)/1.15 var(--f-sans); letter-spacing:-.03em; margin:12px 0 0; text-wrap:balance; }
  time { font:400 13px/1 var(--f-mono); color:var(--muted); }
  .prose { margin-top:20px; }
  .prose :global(p) { margin:0 0 1.1em; }
  .prose :global(h2) { font:600 22px/1.3 var(--f-sans); letter-spacing:-.02em; margin:1.8em 0 .6em; }
  .prose :global(h3) { font:600 18px/1.3 var(--f-sans); margin:1.5em 0 .5em; }
  .prose :global(a) { color:var(--accent); text-underline-offset:3px; }
  .prose :global(blockquote) { margin:1.4em 0; padding-left:16px; border-left:2px solid var(--accent); color:var(--muted); }
  .prose :global(ul), .prose :global(ol) { padding-left:22px; margin:0 0 1.1em; }
  .prose :global(code) { font:400 .9em var(--f-mono); background:color-mix(in srgb,var(--ink) 6%,transparent); padding:2px 5px; border-radius:4px; }
  .prose :global(pre) { font:400 13px/1.6 var(--f-mono); background:var(--surface); border:1px solid var(--line); border-radius:8px; padding:14px 16px; overflow-x:auto; }
  .prose :global(pre code) { background:none; padding:0; }
  .prose :global(img) { max-width:100%; border-radius:8px; }
  .prose :global(table) { width:100%; border-collapse:collapse; margin:1.4em 0; font-size:14.5px; display:block; overflow-x:auto; }
  .prose :global(th), .prose :global(td) { text-align:left; padding:9px 12px; border-bottom:1px solid var(--line); vertical-align:top; }
  .prose :global(th) { font:500 12.5px/1.4 var(--f-mono); color:var(--muted); border-bottom-color:var(--divider); }
</style>
