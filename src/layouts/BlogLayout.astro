---
// Plantilla común del blog. Los colores y modos claro/oscuro vienen de src/styles/tokens.css, igual que el CV.
import '../styles/tokens.css';
interface Props {
  title: string;
  description?: string;
  lang: 'en' | 'es';
  altHref: string; // la misma página en el otro idioma
}
const { title, description = '', lang, altHref } = Astro.props;
const t = {
  en: { cv: 'CV', blog: 'Blog', light: 'Light', dark: 'Dark' },
  es: { cv: 'CV', blog: 'Blog', light: 'Claro', dark: 'Oscuro' },
}[lang];
const blogHref = lang === 'es' ? '/es/blog' : '/blog';
const cvHref = lang === 'es' ? '/cv?lang=es' : '/cv?lang=en';
const homeHref = lang === 'es' ? '/?lang=es' : '/?lang=en';
const enHref = lang === 'en' ? Astro.url.pathname : altHref;
const esHref = lang === 'es' ? Astro.url.pathname : altHref;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="alternate" hreflang={lang === 'en' ? 'es' : 'en'} href={altHref} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Geist+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600&display=swap" />
  <!-- Aplica el tema guardado antes de pintar, para que no parpadee -->
  <script is:inline>
    try {
      const th = localStorage.getItem('theme');
      if (th === 'light' || th === 'dark') document.documentElement.dataset.theme = th;
    } catch (e) {}
  </script>
</head>
<body>
  <div class="ctrl">
    <span role="group" aria-label="Language">
      <a href={esHref} data-lang="es" aria-current={lang === 'es' ? 'true' : undefined}>ES</a>
      <a href={enHref} data-lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
    </span>
    <span class="sep"></span>
    <span role="group" aria-label="Theme">
      <button data-theme-set="light">{t.light}</button>
      <button data-theme-set="dark">{t.dark}</button>
    </span>
  </div>

  <header class="top">
    <div class="wrap">
      <a class="name" href={homeHref}>Álvaro <em>Liébana</em></a>
      <nav>
        <a href={cvHref}>{t.cv}</a>
        <a href={blogHref} aria-current="page">{t.blog}</a>
      </nav>
    </div>
  </header>
  <main class="wrap"><slot /></main>
  <footer class="wrap">Álvaro Liébana Carrascosa · {new Date().getFullYear()}</footer>

  <script is:inline>
    // Idioma: se recuerda igual que en el CV
    document.querySelectorAll('[data-lang]').forEach((a) =>
      a.addEventListener('click', () => {
        try { localStorage.setItem('lang', a.dataset.lang); } catch (e) {}
      })
    );
    // Tema: se recuerda; si no hay elección, sigue al sistema
    const btns = document.querySelectorAll('[data-theme-set]');
    const current = () =>
      document.documentElement.dataset.theme ||
      (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const mark = () => btns.forEach((b) => b.setAttribute('aria-pressed', b.dataset.themeSet === current()));
    btns.forEach((b) =>
      b.addEventListener('click', () => {
        document.documentElement.dataset.theme = b.dataset.themeSet;
        try { localStorage.setItem('theme', b.dataset.themeSet); } catch (e) {}
        mark();
      })
    );
    mark();
  </script>
</body>
</html>

<style is:global>
  body { margin:0; background:var(--bg); color:var(--ink); font:400 17px/1.7 var(--f-sans); -webkit-font-smoothing:antialiased; }
  a { color:inherit; }
  .wrap { width:min(720px, 100% - 32px); margin-inline:auto; }

  /* Cabecera: la banda azul de la portada */
  .top { background:var(--band); color:#fff; padding-block:22px; }
  .top .wrap { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:baseline; gap:12px; }
  .top .name { font:700 22px/1.2 var(--f-display); letter-spacing:-.025em; text-decoration:none; }
  .top .name em { font-style:normal; color:#e8b04a; }
  .top nav { display:flex; gap:18px; font:600 15px/1 var(--f-sans); }
  .top nav a { text-decoration:none; opacity:.85; }
  .top nav a:hover, .top nav a[aria-current="page"] { opacity:1; text-decoration:underline; text-decoration-color:#e8b04a; text-decoration-thickness:2px; text-underline-offset:5px; }
  @media (max-width:1180px) { .top { padding-top:62px; } } /* sitio para los selectores */

  main.wrap { padding-block:48px 64px; }

  /* Selectores de idioma y tema, como en el CV */
  .ctrl { position:fixed; top:16px; right:16px; z-index:10; display:flex; align-items:center; gap:2px; padding:3px; border:1px solid var(--line); border-radius:10px; background:color-mix(in srgb,var(--surface) 85%,transparent); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); }
  .ctrl > span[role] { display:contents; }
  .ctrl a, .ctrl button { appearance:none; font:500 12px/1 var(--f-mono); color:var(--muted); background:transparent; border:0; border-radius:7px; padding:7px 10px; cursor:pointer; text-decoration:none; }
  .ctrl a[aria-current="true"], .ctrl button[aria-pressed="true"] { background:var(--surface); color:var(--ink); box-shadow:var(--shadow); }
  .ctrl .sep { width:1px; align-self:stretch; margin:4px 3px; background:var(--line); }
  @media (max-width:560px) { .ctrl { position:absolute; } }

  footer.wrap { border-top:1px solid var(--divider); padding-block:18px 40px; font:400 12px/1.6 var(--f-mono); color:var(--faint); }
</style>
