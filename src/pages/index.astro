---
// Página de presentación: elegante pero informal, con portada en azul marino, arena y arcilla, Familjen Grotesk,
// esquinas suaves y movimiento discreto.
import LandingLayout from '../layouts/LandingLayout.astro';
import T from '../components/T.astro';
import CvMenu from '../components/CvMenu.astro';
import { about, blog, contact, cvMenu, cvPdf, hero, links, nav, path, posts, work } from '../data/landing.js';

const logos = [
  { name: 'Aegis', src: '/img/logos/aegis.svg', href: 'https://aegis-midnight.vercel.app/' },
  { name: 'Gaia', src: '/img/logos/gaia.webp', href: 'https://tricubo.tech/gaia' },
  { name: 'SnowPDF', src: '/img/logos/snowpdf.webp', href: 'https://github.com/Leyenda95/snowpdf' },
  { name: 'Project Catalyst', src: '/img/logos/catalyst.svg', href: 'https://projectcatalyst.io/' },
];
const fonts = 'https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400..700&family=Hanken+Grotesk:wght@400..600&display=swap';
const ticker = ['Midnight', 'Compact', 'Zero-knowledge', 'Algorand', 'Cardano', 'Solidity', 'Notion', 'TypeScript', 'Python', 'C/C++', 'Node.js', 'ClickUp', 'React', 'React Native', 'Docker', 'GitHub'];
// Dibujos a medida de los pilares, en el orden de about.pillars. La clase "a" lleva el color de acento:
// privacidad: texto con trozos tachados (se ve solo lo que eliges mostrar)
// producto: un garabato que se ordena hasta acabar en línea recta y en un punto (del problema al final)
// IA: un bucle que se cierra con un tick y sigue su camino (el agente itera y el código queda validado)
const pillarIcons = [
  '<path d="M3 12h24M3 32h6M3 52h46"/><rect class="a" x="35" y="5" width="58" height="14" rx="4"/><rect class="a" x="17" y="25" width="44" height="14" rx="4"/><path d="M69 32h24"/><rect class="a" x="57" y="45" width="36" height="14" rx="4"/>',
  '<path d="M4 46C10 16 30 6 28 26S6 56 18 54 42 12 44 30 30 54 42 48C54 42 58 32 70 32h12"/><circle class="a" cx="89" cy="32" r="6"/>',
  '<path d="M51 16A25 25 0 1 0 57 32"/><path d="M42 15l9.500 1 .5-9.500"/><path class="t" d="m21 32 7.500 7.500L43 24"/><circle class="a" cx="70" cy="32" r="4"/><circle class="a" cx="81" cy="32" r="3"/><circle class="a" cx="90" cy="32" r="2"/>',
];
const icons = {
  cap: '<path d="m2 9 10-5 10 5-10 5z"/><path d="M6 11.5V16c2 2.2 10 2.2 12 0v-4.5"/>',
  net: '<circle cx="12" cy="5" r="2.5"/><circle cx="5" cy="19" r="2.5"/><circle cx="19" cy="19" r="2.5"/><path d="M12 7.5V12m0 0-5.5 5M12 12l5.5 5"/>',
  wave: '<path d="M2 12h3l2-6 3 13 3-16 3 12 2-3h4"/>',
  buoy: '<path d="M12 3v5M8 8h8l2 8H6z"/><path d="M3 19.5c2 0 2 1.5 4.5 1.5S10 19.5 12 19.5s2 1.5 4.5 1.5 2.5-1.5 4.5-1.5"/>',
  receipt: '<path d="M6 3h12v18l-2-1.5-2 1.5-2-1.5-2 1.5-2-1.5L6 21z"/><path d="M9 8h6M9 12h6"/>',
  check: '<path d="M6 3h12v18H6z"/><path d="m9 12 2 2 4-4"/>',
  shield: '<path d="m12 3 8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="m9 12 2 2 4-4"/>',
};
---
<LandingLayout fonts={fonts}>
  <header class="hero">
    <nav class="top wrap">
      <div class="navlinks">{nav.map((n) => <a href={n.href}><T t={n.label} /></a>)}</div>
    </nav>
    <div class="hero-grid wrap">
      <div>
        <T class="sticker" t={hero.status} />
        <h1 data-en="Hi, I’m Álvaro.">Hola, soy Álvaro.</h1>
        <T as="p" class="role" t={hero.role} />
        <T as="p" class="intro" t={hero.intro} />
        <div class="cta">
          <a class="btn solid" href="#work"><T t={hero.seeWork} /></a>
          <CvMenu class="btn-menu" />
          <a class="btn" href="#contact"><T t={hero.contact} /></a>
        </div>
      </div>
      <figure class="hero-photo">
        <img src="/img/talk-cutout-v2.webp" width="810" height="1212" alt="Álvaro dando una charla" data-en-alt="Álvaro giving a talk" />
        {logos.map((l) => <a class="badge" href={l.href} target="_blank" rel="noopener" title={l.name}><img src={l.src} alt={l.name} /></a>)}
      </figure>
    </div>
    <div class="ticker" aria-hidden="true">
      <div>{[...ticker, ...ticker].map((x) => <span>{x}</span>)}</div>
    </div>
    <script is:inline>
      // Imán de los logos: con ratón, cada pelota se acerca al cursor y su logo un poco más
      (() => {
        if (!matchMedia('(hover:hover) and (pointer:fine)').matches) return;
        const RADIUS = 130, PULL = 0.5, INNER = 0.15;
        const balls = [...document.querySelectorAll('.badge')].map((el) => ({ el, x: 0, y: 0 }));
        let queued = false, px = 0, py = 0;
        const set = (b, x, y) => {
          b.x = x; b.y = y;
          b.el.style.setProperty('--mx', x + 'px');
          b.el.style.setProperty('--my', y + 'px');
          b.el.style.setProperty('--ix', x * INNER / PULL + 'px');
          b.el.style.setProperty('--iy', y * INNER / PULL + 'px');
        };
        const paint = () => {
          queued = false;
          balls.forEach((b) => {
            const r = b.el.getBoundingClientRect();
            const dx = px - (r.left + r.width / 2 - b.x), dy = py - (r.top + r.height / 2 - b.y);
            const force = Math.max(0, 1 - Math.hypot(dx, dy) / RADIUS) * PULL;
            set(b, dx * force, dy * force);
          });
        };
        document.addEventListener('pointermove', (e) => {
          px = e.clientX; py = e.clientY;
          if (!queued) { queued = true; requestAnimationFrame(paint); }
        }, { passive: true });
        document.documentElement.addEventListener('pointerleave', () => balls.forEach((b) => set(b, 0, 0)));
      })();
    </script>
    <script is:inline>
      // Pantallas táctiles: el banner solo se para mientras el dedo sigue encima
      (() => {
        const banner = document.querySelector('.ticker');
        const hold = (on) => () => banner.classList.toggle('held', on);
        banner.addEventListener('touchstart', hold(true), { passive: true });
        banner.addEventListener('touchend', hold(false));
        banner.addEventListener('touchcancel', hold(false));
      })();
    </script>
  </header>

  <main>
    <section id="about" class="wrap about">
      <div>
        <T as="h2" t={about.title} />
        {about.paragraphs.map((p) => <T as="p" t={p} />)}
      </div>
      <img src="/img/stage-gesture.webp" width="1400" height="933" loading="lazy" alt="Álvaro explicando una diapositiva en un escenario" data-en-alt="Álvaro explaining a slide on stage" />
      <ul class="pillars">
        {about.pillars.map((p, i) => (
          <li><span class="pillar-icon"><svg viewBox="0 0 96 64" aria-hidden="true"><Fragment set:html={pillarIcons[i]} /></svg></span><T as="h3" t={p.title} /><T as="p" t={p.text} /></li>
        ))}
      </ul>
    </section>

    <section id="work" class="wrap">
      <T as="h2" t={['Proyectos seleccionados', work.title[1]]} />
      <div class="cards">
        {work.items.map((w) => (
          <article class="card">
            <div class="card-top"><h3>{w.name}</h3><span class="when">{w.when}</span></div>
            <T as="p" class="card-role" t={w.role} />
            <T as="p" t={w.text} />
            <div class="tags">{w.tags.map((t) => (Array.isArray(t) ? <T t={t} /> : <span>{t}</span>))}</div>
            {w.link && (
              <div class="card-links">
                <a class="more" href={w.link.href} target="_blank" rel="noopener"><T t={w.link.label} /> ↗</a>
                {w.site && <a class="more" href={w.site.href} target="_blank" rel="noopener"><T t={w.site.label} /> ↗</a>}
              </div>
            )}
          </article>
        ))}
      </div>
    </section>

    <section id="path" class="path">
      <div class="wrap">
        <T as="h2" t={path.title} />
        <T as="p" class="path-sub" t={path.sub} />
        <div class="route" id="route">
          <svg class="route-line" aria-hidden="true"><path class="road" /><path class="trail" /></svg>
          <ol>
            {path.items.map((p) => (
              <li class="stage">
                <span class="stop"><svg viewBox="0 0 24 24" aria-hidden="true"><Fragment set:html={icons[p.icon]} /></svg></span>
                <article class="stage-card">
                  {Array.isArray(p.when) ? <T class="stage-when" t={p.when} /> : <span class="stage-when">{p.when}</span>}
                  <T as="h3" t={p.org} />
                  <T as="p" class="stage-role" t={p.role} />
                  <T as="p" t={p.text} />
                </article>
              </li>
            ))}
          </ol>
        </div>
        <div class="path-more">
          <a href="/cv"><T t={path.more} /> →</a>
          <details class="cvmenu path-pdf">
            <summary><T t={cvMenu.pdf} /><svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="m2.5 4.5 3.5 3.5 3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
            <div class="cvmenu-list">
              <div class="cvmenu-langs">
                <a href={cvPdf.es} hreflang="es" lang="es" target="_blank" rel="noopener">Español</a>
                <a href={cvPdf.en} hreflang="en" lang="en" target="_blank" rel="noopener">English</a>
              </div>
            </div>
          </details>
        </div>
      </div>
      <script is:inline>
        // Camino de la trayectoria: une las paradas con una curva y la pinta según se hace scroll
        (() => {
          const route = document.getElementById('route');
          const svg = route.querySelector('.route-line');
          const [road, trail] = svg.querySelectorAll('path');
          const stops = [...route.querySelectorAll('.stop')];
          const radius = stops[0].offsetWidth / 2;
          const SMOOTH = 0.25; // segundos de inercia del trazo: más alto, más suave y más rezagado
          let points = [], lengths = [], total = 0;
          let drawn = -radius - 1, goal = drawn, speed = 0, frame = 0, last = 0; // longitud pintada, longitud a la que debe llegar y velocidad

          // Longitud del camino a la altura y; antes de la primera parada es negativa
          function lengthAtY(y) {
            if (y <= points[0].y) return Math.max(y - points[0].y, -radius - 1);
            const i = points.findIndex((p) => p.y >= y);
            if (i < 0) return total;
            const share = (y - points[i - 1].y) / (points[i].y - points[i - 1].y);
            return lengths[i - 1] + (lengths[i] - lengths[i - 1]) * share;
          }
          function paint() {
            trail.style.strokeDashoffset = total - Math.max(drawn, 0);
            // Cada parada se enciende cuando el trazo toca el borde de su círculo
            stops.forEach((s, i) => s.classList.toggle('passed', drawn >= lengths[i] - radius));
          }
          // Muelle críticamente amortiguado: acelera y frena sin cambios bruscos, a cualquier tasa de refresco
          function tick(now) {
            const dt = last ? Math.min((now - last) / 1000, 0.05) : 1 / 60;
            last = now;
            const omega = 2 / SMOOTH, decay = Math.exp(-omega * dt);
            const gap = drawn - goal, push = (speed + omega * gap) * dt;
            speed = (speed - omega * push) * decay;
            drawn = goal + (gap + push) * decay;
            if (Math.abs(goal - drawn) < 0.1 && Math.abs(speed) < 1) { drawn = goal; speed = 0; }
            paint();
            frame = drawn === goal && !speed ? 0 : requestAnimationFrame(tick);
            if (!frame) last = 0;
          }
          function follow() {
            goal = lengthAtY(innerHeight * 0.65 - route.getBoundingClientRect().top);
            if (!frame) frame = requestAnimationFrame(tick);
          }
          function draw() {
            const box = route.getBoundingClientRect();
            points = stops.map((s) => {
              const r = s.getBoundingClientRect();
              return { x: r.left + r.width / 2 - box.left, y: r.top + r.height / 2 - box.top };
            });
            const parts = points.map((p, i) => {
              if (!i) return `M${p.x} ${p.y}`;
              const q = points[i - 1], mid = (q.y + p.y) / 2;
              return `C${q.x} ${mid} ${p.x} ${mid} ${p.x} ${p.y}`;
            });
            // Longitud de la curva hasta cada parada
            lengths = parts.map((_, i) => {
              trail.setAttribute('d', parts.slice(0, i + 1).join(''));
              return trail.getTotalLength();
            });
            const d = parts.join('');
            svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
            road.setAttribute('d', d);
            trail.setAttribute('d', d);
            total = trail.getTotalLength();
            trail.style.strokeDasharray = total;
            paint();
            follow();
          }
          addEventListener('scroll', follow, { passive: true });
          new ResizeObserver(draw).observe(route); // cubre el cambio de idioma y la carga de fuentes
        })();
      </script>
    </section>

    <section id="blog" class="wrap">
      <div class="head-row">
        <T as="h2" t={blog.title} />
        <a class="more" href="/blog" data-href-es="/es/blog" data-href-en="/blog"><T t={blog.all} /> →</a>
      </div>
      <T as="p" class="blog-sub" t={blog.sub} />
      <ul class="posts">
        {posts.slice(0, 4).map((p) => (
          <li>
            <a href={`/blog/${p.slug}`} data-href-es={`/es/blog/${p.slug}`} data-href-en={`/blog/${p.slug}`}>
              <T class="p-title" t={p.title} />
              <time>{p.date}</time>
            </a>
          </li>
        ))}
      </ul>
      <script is:inline>
        // Las entradas aparecen escalonadas la primera vez que el blog entra en pantalla
        (() => {
          const list = document.querySelector('.posts');
          list.querySelectorAll('li').forEach((li, i) => li.style.setProperty('--i', i));
          list.classList.add('reveal');
          new IntersectionObserver(([entry], observer) => {
            if (!entry.isIntersecting) return;
            list.classList.add('in');
            observer.disconnect();
          }, { rootMargin: '0px 0px -12% 0px' }).observe(list);
        })();
      </script>
    </section>

    <section id="contact" class="contact">
      <div class="wrap">
        <T as="h2" t={contact.title} />
        <T as="p" t={contact.text} />
        <a class="mail" href={`mailto:${links.email}`}>{links.email}</a>
        <div class="socials">
          <a href={links.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
          <a href={links.github} target="_blank" rel="noopener">GitHub ↗</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="wrap">Álvaro Liébana Carrascosa · {new Date().getFullYear()}</footer>
</LandingLayout>

<style is:global>
  body {
    --marino:#13223f; --marino-claro:#1e3154; --arena:#ebe1d1; --crema:#f7f2e9; --papel:#fcfaf5; --arcilla:#a3441d; --melocoton:#eab08f;
    --sans:"Hanken Grotesk", system-ui, -apple-system, "Segoe UI", sans-serif;
    --display:"Familjen Grotesk", system-ui, -apple-system, "Segoe UI", sans-serif;
    --sombra-menu:0 14px 34px rgba(19,34,63,.18);
    /* Colores de los selectores comunes */
    --surface:var(--papel); --ink:var(--marino); --muted:#5a6377; --line:#ddd2bf; --accent:var(--marino); --shadow:0 1px 2px rgba(19,34,63,.14); color-scheme:light;
    --f-mono:var(--sans);
    /* Desplegable del CV */
    --menu-bg:var(--papel); --menu-ink:var(--marino); --menu-border:1px solid var(--line); --menu-radius:12px; --menu-shadow:var(--sombra-menu); --menu-hover:var(--arena);
    margin:0; background:var(--crema); color:var(--marino); font:400 17px/1.65 var(--sans); -webkit-font-smoothing:antialiased; overflow-x:hidden;
  }
  /* Resaltado visible sobre todos los fondos: el del navegador apenas se ve sobre el azul marino */
  ::selection { background:var(--melocoton); color:var(--marino); }
  .pillars li:nth-child(2) ::selection, .btn.solid ::selection { background:var(--marino); color:var(--crema); }
  .wrap { width:min(1120px, 100% - 40px); margin-inline:auto; }
  a { color:inherit; }
  h1, h2, h3 { font-family:var(--display); font-weight:500; letter-spacing:-.02em; margin:0; }
  h2 { font-size:clamp(36px, 5.5vw, 60px); font-weight:500; letter-spacing:-.03em; line-height:1.08; margin-bottom:28px; }
  section.wrap { padding-block:clamp(56px, 8vw, 96px); scroll-margin-top:16px; }
  :focus-visible { outline:2px solid currentColor; outline-offset:3px; }

  /* Portada */
  .hero { background:var(--marino); color:var(--crema); }
  /* El menú comparte el centro con el selector de idioma: misma posición y mismo alto (16px + 34px) */
  .top { display:flex; flex-wrap:wrap; align-items:center; gap:12px 28px; padding-block:16px 21px; padding-right:130px; }
  .navlinks { display:flex; flex-wrap:wrap; align-items:center; min-height:34px; gap:6px 22px; font-size:16.5px; }
  .navlinks a { line-height:1; text-decoration:none; font-weight:500; opacity:.82; transition:opacity .2s ease; }
  .navlinks a:hover { opacity:1; text-decoration:underline; text-decoration-color:var(--melocoton); text-decoration-thickness:1.5px; text-underline-offset:5px; }
  .hero-grid { display:grid; grid-template-columns:minmax(0,1.25fr) minmax(0,.75fr); gap:48px; align-items:center; padding-block:clamp(28px, 5vw, 64px) clamp(48px, 6vw, 80px); }
  .sticker { display:inline-flex; align-items:center; gap:9px; font-weight:500; font-size:15px; }
  .sticker::before { content:""; width:8px; height:8px; border-radius:50%; background:var(--melocoton); }
  h1 { font-size:clamp(56px, 10vw, 118px); font-weight:500; letter-spacing:-.04em; line-height:1; margin:20px 0 18px; }
  .role { font:500 clamp(19px, 2.2vw, 24px)/1.3 var(--display); letter-spacing:-.012em; color:var(--melocoton); margin:0 0 14px; }
  .intro { max-width:54ch; margin:0 0 28px; font-size:18px; }
  .cta { display:flex; flex-wrap:wrap; gap:12px; }
  .btn, .btn-menu > summary { display:inline-flex; align-items:center; font:500 16px/1 var(--sans); padding:15px 22px; border-radius:10px; border:1px solid color-mix(in srgb,var(--crema) 45%,transparent); color:var(--crema); text-decoration:none; background:transparent; transition:background .22s ease, border-color .22s ease, color .22s ease; }
  .btn.solid { background:var(--melocoton); border-color:var(--melocoton); color:var(--marino); }
  .btn:hover, .btn-menu > summary:hover { border-color:var(--crema); background:color-mix(in srgb,var(--crema) 10%,transparent); }
  .btn.solid:hover { background:var(--crema); border-color:var(--crema); }
  .ticker { border-top:1px solid color-mix(in srgb,var(--crema) 20%,transparent); background:var(--marino); overflow:hidden; padding-block:13px; }
  .ticker > div { display:flex; width:max-content; animation:slide 64s linear infinite; font:500 14px/1 var(--sans); }
  .ticker span { padding-inline:22px; white-space:nowrap; }
  .ticker span::after { content:""; display:inline-block; width:.3em; height:.3em; border-radius:50%; background:var(--melocoton); vertical-align:.12em; margin-left:44px; } /* punto dibujado: el de la fuente es cuadrado */
  /* Se para con el ratón encima o, en pantallas táctiles, mientras se mantiene el dedo */
  @media (hover:hover) { .ticker:hover > div { animation-play-state:paused; } }
  .ticker.held > div { animation-play-state:paused; }
  .ticker { -webkit-user-select:none; user-select:none; -webkit-touch-callout:none; }
  @keyframes slide { to { transform:translateX(-50%); } }
  @media (max-width:820px) { .hero-grid { grid-template-columns:minmax(0,1fr); }  }

  /* Sobre mí */
  .about { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:40px 56px; align-items:center; }
  .about p { margin:0 0 16px; max-width:60ch; }
  .about > img { display:block; width:100%; height:auto; border-radius:14px; }
  .pillars { grid-column:1 / -1; list-style:none; margin:16px 0 0; padding:0; display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); gap:18px; }
  /* Tres bloques de la paleta, cada uno con su dibujo a medida */
  .pillars li { display:flex; flex-direction:column; align-items:flex-start; padding:18px 20px; border-radius:14px; }
  .pillars li:nth-child(1) { background:var(--marino); color:var(--crema); --acento:var(--melocoton); }
  .pillars li:nth-child(2) { background:var(--melocoton); color:var(--marino); --acento:var(--marino); }
  .pillars li:nth-child(3) { background:var(--arena); color:var(--marino); --acento:var(--arcilla); }
  .pillar-icon { display:block; margin-bottom:12px; }
  .pillar-icon svg { display:block; width:54px; height:36px; fill:none; stroke:currentColor; stroke-width:2.6; stroke-linecap:round; stroke-linejoin:round; }
  .pillar-icon .a { fill:var(--acento); stroke:none; }
  .pillar-icon .t { stroke:var(--acento); stroke-width:3.6; }
  .pillars h3 { font-size:30px; line-height:1.1; letter-spacing:-.025em; margin-bottom:8px; }
  .pillars p { margin:0; font-size:16px; line-height:1.5; }
  @media (max-width:820px) { .about, .pillars { grid-template-columns:minmax(0,1fr); } }

  /* Proyectos */
  /* Tarjetas escalonadas como en producción, con línea fina y una sombra plana de la paleta en cada una */
  .cards { display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); gap:26px; }
  .card { --sombra-color:var(--marino); background:var(--papel); border:1px solid var(--line); border-radius:16px; padding:26px; box-shadow:7px 7px 0 var(--sombra-color); transition:transform .22s ease, box-shadow .22s ease; display:flex; flex-direction:column; gap:10px; }
  .card:nth-child(2) { --sombra-color:var(--melocoton); }
  .card:nth-child(3) { --sombra-color:var(--arcilla); }
  .card:hover { transform:translate(-3px,-3px); box-shadow:10px 10px 0 var(--sombra-color); }
  .card-top { display:flex; justify-content:space-between; align-items:baseline; gap:12px; flex-wrap:wrap; }
  .card h3 { font-size:30px; line-height:1.1; letter-spacing:-.025em; }
  .when { font:500 12.5px/1 var(--sans); letter-spacing:.04em; font-variant-numeric:tabular-nums; color:var(--muted); white-space:nowrap; }
  .card p { margin:0; font-size:16px; line-height:1.55; }
  .card .card-role { font-weight:500; color:var(--arcilla); }
  .tags { display:flex; flex-wrap:wrap; gap:6px; padding-top:4px; margin-top:auto; }
  .tags span { font:500 13px/1 var(--sans); padding:6px 9px; border-radius:6px; background:var(--arena); }
  .more { align-self:flex-start; font-weight:500; text-decoration-color:var(--arcilla); text-decoration-thickness:1.5px; text-underline-offset:5px; }
  .card-links { display:flex; flex-wrap:wrap; gap:6px 18px; }
  @media (max-width:820px) { .cards { grid-template-columns:minmax(0,1fr); } }

  /* Trayectoria: un camino que une las etapas y se pinta al hacer scroll */
  .path { background:var(--marino); color:var(--crema); padding-block:clamp(56px, 8vw, 96px); scroll-margin-top:0; }
  .path h2 { margin-bottom:8px; }
  .path-sub { margin:0 0 clamp(32px, 5vw, 56px); font:500 clamp(19px, 2.2vw, 24px)/1.3 var(--display); letter-spacing:-.012em; color:var(--melocoton); }
  .route { position:relative; }
  .route-line { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; overflow:visible; }
  .route-line path { fill:none; stroke-linecap:round; }
  .road { stroke:color-mix(in srgb,var(--crema) 30%,transparent); stroke-width:1.5; stroke-dasharray:2 8; }
  .trail { stroke:var(--melocoton); stroke-width:2; }
  .route ol { position:relative; list-style:none; margin:0; padding:0; }
  .stage { display:grid; grid-template-columns:minmax(0,1fr) 84px minmax(0,1fr); align-items:center; }
  .stage + .stage { margin-top:-44px; }
  .stage:nth-child(odd) .stage-card { grid-column:1; grid-row:1; }
  .stage:nth-child(even) .stage-card { grid-column:3; grid-row:1; }
  .stage .stop { grid-column:2; grid-row:1; justify-self:center; }
  .stage:nth-child(odd) .stop { margin-right:30px; }
  .stage:nth-child(even) .stop { margin-left:30px; }
  .stop { position:relative; z-index:1; display:grid; place-items:center; width:54px; height:54px; border-radius:50%; background:var(--marino-claro); color:var(--crema); border:1px solid color-mix(in srgb,var(--crema) 35%,transparent); transition:background .2s ease, color .2s ease, border-color .2s ease; }
  .stop.passed { background:var(--melocoton); border-color:var(--melocoton); color:var(--marino); }
  .stop svg { width:24px; height:24px; fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }
  .stage-card { background:var(--marino-claro); border-radius:14px; padding:22px 24px; display:flex; flex-direction:column; gap:4px; }
  .stage-when { font:500 clamp(24px, 3vw, 32px)/1.1 var(--display); letter-spacing:-.025em; color:var(--melocoton); }
  .stage-card h3 { font-size:20px; letter-spacing:-.015em; line-height:1.25; margin-top:4px; }
  .stage-card p { margin:0; font-size:15.5px; line-height:1.5; }
  .stage-card .stage-role { font-weight:500; }
  /* La última parada es hoy */
  .stage:last-child .stage-card { background:var(--crema); color:var(--marino); }
  .stage:last-child .stage-when { color:var(--arcilla); }
  .path-more { display:flex; flex-wrap:wrap; justify-content:center; gap:12px 32px; margin-top:clamp(28px, 4vw, 44px); }
  .path-more > a, .path-pdf > summary { font-weight:500; text-decoration:underline; text-decoration-color:var(--melocoton); text-decoration-thickness:1.5px; text-underline-offset:5px; }
  .path-pdf > summary { display:inline; }
  .path-pdf > summary svg { display:inline; margin-left:6px; vertical-align:-1px; }
  /* Centrado bajo el enlace; hacia arriba o hacia abajo lo decide LandingLayout según el sitio */
  .path-pdf .cvmenu-list { left:50%; transform:translateX(-50%); min-width:210px; }
  @media (max-width:820px) {
    .stage { grid-template-columns:54px minmax(0,1fr); gap:14px; align-items:start; }
    .stage + .stage { margin-top:22px; }
    .stage:nth-child(n) .stop { grid-column:1; justify-self:start; margin:14px 0 0; }
    .stage:nth-child(n) .stage-card { grid-column:2; }
  }

  /* Blog */
  .head-row { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:baseline; gap:12px; }
  .head-row h2 { margin-bottom:0; }
  .blog-sub { margin:8px 0 24px; color:var(--muted); }
  .posts { list-style:none; margin:0; padding:0; border-top:1px solid color-mix(in srgb,var(--marino) 45%,transparent); }
  .posts li { position:relative; }
  .posts li::after { content:""; position:absolute; inset:auto 0 0; height:1px; background:color-mix(in srgb,var(--marino) 28%,transparent); transform-origin:left; }
  .posts.reveal li { opacity:0; transform:translateY(14px); transition:opacity .6s ease calc(var(--i) * 110ms), transform .6s cubic-bezier(.2,.7,.2,1) calc(var(--i) * 110ms); }
  .posts.reveal li::after { transform:scaleX(0); transition:transform .9s cubic-bezier(.2,.7,.2,1) calc(var(--i) * 110ms + 150ms); }
  .posts.reveal.in li { opacity:1; transform:none; }
  .posts.reveal.in li::after { transform:none; }
  .posts a { display:flex; justify-content:space-between; align-items:baseline; gap:8px 24px; flex-wrap:wrap; padding:20px 4px; text-decoration:none; transition:color .22s ease; }
  .posts a:hover { color:var(--arcilla); }
  .p-title { font:500 clamp(19px, 2.2vw, 23px)/1.3 var(--display); letter-spacing:-.015em; flex:1 1 320px; transition:transform .25s ease; }
  /* Con ancho 0, la flecha no cambia cómo se parten los títulos largos */
  .p-title::after { content:"→"; display:inline-block; width:0; margin-left:10px; white-space:nowrap; opacity:0; transform:translateX(-10px); transition:opacity .25s ease, transform .25s ease; }
  @media (hover:hover) {
    .posts a:hover .p-title { transform:translateX(6px); }
    .posts a:hover .p-title::after { opacity:1; transform:none; }
  }
  .posts time { font:500 12.5px/1 var(--sans); letter-spacing:.04em; font-variant-numeric:tabular-nums; color:var(--muted); }

  /* Contacto */
  .contact { background:var(--arena); color:var(--marino); padding-block:clamp(64px, 9vw, 110px); }
  .contact p { max-width:56ch; margin:0 0 26px; font-size:18px; }
  .mail { display:inline-block; font:500 clamp(24px, 3vw, 36px)/1.1 var(--display); letter-spacing:-.025em; color:var(--arcilla); text-decoration-thickness:1.5px; text-underline-offset:7px; overflow-wrap:anywhere; }
  .socials { display:flex; gap:20px; margin-top:26px; font-weight:500; font-size:16px; }
  .socials a { text-decoration-color:var(--arcilla); text-decoration-thickness:1.5px; text-underline-offset:5px; }

  footer.wrap { padding-block:22px; font-size:12.5px; line-height:1.5; letter-spacing:.02em; color:var(--muted); }

  /* En pantallas táctiles el hover se queda pegado tras pulsar */
  @media (hover:none) {
    .btn:hover, .btn-menu > summary:hover { background:transparent; border-color:color-mix(in srgb,var(--crema) 45%,transparent); }
    .btn.solid:hover { background:var(--melocoton); border-color:var(--melocoton); }
    .card:hover { transform:none; box-shadow:7px 7px 0 var(--sombra-color); }
    .posts a:hover { color:inherit; }
  }

  /* Móvil: misma estructura con tamaños menores. La portada ocupa la pantalla y el banner queda en su borde inferior */
  @media (max-width:640px) {
    body { font-size:16px; line-height:1.55; }
    .wrap { width:calc(100% - 32px); }
    h2 { font-size:32px; margin-bottom:18px; }
    section.wrap { padding-block:44px; }

    /* Cabecera: el menú ocupa la línea del selector de idioma, a su izquierda */
    .top { padding-block:10px 6px; padding-right:66px; } /* deja aire entre el menú y el selector de idioma */
    body .ctrl { top:10px; }
    /* Selector de un solo botón: solo se ve el idioma al que se puede cambiar */
    body .ctrl button { padding:7px 7px; font-size:11px; color:var(--ink); }
    body .ctrl button[aria-pressed="true"] { display:none; }
    .navlinks { flex:1; min-width:0; min-height:33px; align-items:center; flex-wrap:nowrap; justify-content:space-between; gap:3px; font-size:clamp(12.5px, 4.1vw, 16.5px); letter-spacing:-.01em; }
    .navlinks a { white-space:nowrap; padding-block:8px; }

    /* Portada centrada: la foto, entera, se queda con el alto que dejan el texto y el banner */
    .hero { display:flex; flex-direction:column; min-height:100vh; min-height:100svh; }
    .hero-grid { flex:1; display:flex; flex-direction:column; justify-content:space-evenly; gap:0; padding-block:6px 14px; text-align:center; }
    .hero-grid > div { display:flex; flex-direction:column; align-items:center; }
    .sticker { font-size:13.5px; gap:7px; }
    h1 { font-size:clamp(30px, 11.4vw, 60px); margin:10px 0 2px; }
    .role { font-size:clamp(16px, 4.6vw, 22px); margin:0 0 10px; }
    .intro { max-width:none; margin:0 0 14px; font-size:16px; line-height:1.45; text-wrap:balance; }
    .cta { align-self:stretch; flex-wrap:nowrap; gap:8px; }
    .cta > * { flex:1 1 auto; }
    .btn, .btn-menu > summary { justify-content:center; font-size:clamp(12px, 4vw, 16px); padding:13px clamp(8px, 3vw, 16px); white-space:nowrap; }
    .btn-menu > summary { display:flex; }
    .ticker { flex:none; }
    .btn-menu > summary { gap:5px; }
    .btn-menu .cvmenu-list { left:50%; transform:translateX(-50%); min-width:210px; }

    /* Banner: más tecnologías a la vista, a una velocidad parecida a la de escritorio */
    .ticker { padding-block:9px; }
    .ticker > div { font-size:11.5px; animation-duration:38s; }
    .ticker span { padding-inline:5px; }
    .ticker span::after { margin-left:10px; }

    /* Sobre mí */
    .about { gap:22px; }
    .about > img { border-radius:12px; }
    .about p { margin-bottom:12px; }
    .pillars { margin-top:6px; gap:12px; }
    .pillars li { padding:14px 16px; border-radius:12px; }
    .pillar-icon { margin-bottom:10px; }
    .pillar-icon svg { width:48px; height:32px; }
    .pillars h3 { font-size:24px; margin-bottom:4px; }
    .pillars p { font-size:16px; }

    /* Proyectos */
    .cards { gap:20px; }
    .card { padding:18px; border-radius:14px; gap:8px; box-shadow:5px 5px 0 var(--sombra-color); }
    .card h3 { font-size:24px; }
    .card p { font-size:16px; line-height:1.5; }

    /* Trayectoria: círculos y tarjetas más pequeños para dar anchura al texto */
    .path { padding-block:44px; }
    .path-sub { font-size:17px; margin-bottom:26px; }
    .stage { grid-template-columns:40px minmax(0,1fr); gap:10px; }
    .stage + .stage { margin-top:16px; }
    .stage:nth-child(n) .stop { margin-top:12px; }
    .stop { width:40px; height:40px; }
    .stop svg { width:19px; height:19px; }
    .stage-card { padding:13px 15px; border-radius:12px; }
    .stage-when { font-size:21px; }
    .stage-card h3 { font-size:18px; margin-top:2px; }
    .stage-card p { font-size:15.5px; line-height:1.45; }

    /* Blog y contacto */
    .posts a { padding-block:14px; }
    .p-title { font-size:17px; flex-basis:100%; }
    .contact { padding-block:52px; }
    .contact p { font-size:16px; margin-bottom:18px; }
    .mail { font-size:clamp(20px, 5.8vw, 28px); text-underline-offset:5px; }
    .socials { margin-top:20px; }
  }

  /* Figura recortada que sale del banner, rodeada de logos */
  .hero-grid { align-items:end; padding-bottom:0; }
  /* Escritorio: el relleno bajo el texto baja la figura y el banner sin mover el texto */
  .hero-grid > div { align-self:start; padding-bottom:40px; }
  @media (min-width:821px) {
    .hero-grid { padding-top:calc(clamp(28px, 5vw, 64px) + 48px); } /* baja todo el contenido respecto al menú */
    .hero-grid > div { padding-bottom:160px; }
  }
  .hero-photo { margin:0; position:relative; width:min(100%, 340px); justify-self:end; }
  @media (min-width:1400px) { .hero-photo { margin-right:-40px; } } /* más separada del texto si hay sitio */
  @media (max-width:1399px) { .hero-photo { margin-right:24px; } } /* sitio para los logos */
  @media (max-width:1260px) { .hero-photo { margin-right:70px; } }
  @media (max-width:1000px) { .hero-photo { margin-right:56px; } }
  @media (max-width:820px) { .hero-photo { justify-self:center; margin-right:0; } }
  .hero-photo > img { display:block; width:100%; height:auto; }
  /* Filas y columnas fijas al hueco: si no, un logo más alto que ancho estira la fila y se sale por abajo */
  .badge { --size:70px; position:absolute; display:grid; grid-template:minmax(0,1fr) / minmax(0,1fr); place-items:center; width:var(--size); height:var(--size); padding:calc(var(--size) * .17); border-radius:50%; background:var(--papel); box-shadow:0 6px 18px rgba(0,0,0,.28); }
  .badge img { display:block; width:100%; height:100%; object-fit:contain; }
  /* Ningún logo baja de la altura de las manos (62 % de la figura). Cada uno flota a su ritmo: la duración y el desfase distintos evitan que se muevan a la vez */
  .badge { animation:badge-float var(--t) ease-in-out var(--d) infinite; }
  .badge:nth-of-type(1) { left:-18%; top:6%; --r:-8deg; --t:5.2s; --d:0s; }
  .badge:nth-of-type(2) { right:-8%; top:-4%; --r:7deg; --t:6.4s; --d:-2.1s; }
  .badge:nth-of-type(3) { left:-28%; top:29%; --r:6deg; --t:5.8s; --d:-3.7s; }
  .badge:nth-of-type(3) img { filter:drop-shadow(0 1px 1.5px rgba(19,34,63,.18)); } /* es muy claro: la sombra lo separa del fondo */
  .badge:nth-of-type(4) { right:-16%; top:22%; --r:-6deg; --t:7s; --d:-1.2s; padding:calc(var(--size) * .08); }
  /* Con la columna de texto estrecha, debajo de los botones para no tapar la introducción */
  @media (min-width:821px) and (max-width:1120px) { .badge:nth-of-type(3) { top:72%; } }
  .badge:focus-visible { animation-play-state:paused; } /* quieto para poder pulsarlo */
  @media (hover:hover) { .badge:hover { animation-play-state:paused; } }
  @keyframes badge-float { 0%, 100% { transform:translateY(0) rotate(var(--r)); } 50% { transform:translateY(var(--float, -12px)) rotate(calc(var(--r) + var(--tilt, 5deg))); } }
  @media (max-width:640px) {
    /* El texto se centra en el alto libre; la figura queda apoyada en el banner */
    .hero-grid { justify-content:flex-start; padding-block:0; }
    .hero-grid > div { align-self:stretch; margin-block:auto; padding-block:8px; }
    /* El alto manda y el ancho sale de la proporción de la foto: nunca se recorta. 425px: lo que ocupa el resto */
    .hero-photo { flex:none; align-self:center; width:auto; aspect-ratio:810 / 1212; height:clamp(168px, calc(100vh - 380px), min(410px, 105vw)); height:clamp(168px, calc(100svh - 380px), min(410px, 105vw)); }
    .hero-photo > img { height:100%; object-fit:cover; }
    .badge { --size:clamp(39px, 11.2vw, 54px); --float:-7px; --tilt:4deg; }
    /* Cerca de la silueta sin pegarse: cada logo se coloca desde su borde más cercano a ella */
    .badge:nth-of-type(1) { left:calc(10% - var(--size)); top:4%; }
    .badge:nth-of-type(2) { left:75%; top:2%; }
    /* A 18px del borde de la pantalla, sin pisar la foto cuando esta es pequeña */
    .badge:nth-of-type(3) { left:max(calc(-16px - var(--size)), calc(50% - 50vw + 18px)); top:28%; }
    .badge:nth-of-type(4) { left:min(calc(100% + 16px), calc(50% + 50vw - var(--size) - 18px)); top:23%; }
  }

  /* Entrada: al cargar, cada pelota sale de detrás de la figura. Va con translate y scale para no chocar con el transform de la flotación */
  .hero-photo { isolation:isolate; }
  .hero-photo > img { position:relative; z-index:1; }
  .badge { z-index:2; translate:var(--mx, 0px) var(--my, 0px); transition:translate .45s cubic-bezier(.2,.8,.2,1); animation:badge-in .85s cubic-bezier(.34,1.45,.5,1) var(--in) backwards, badge-show .85s linear var(--in) backwards, badge-float var(--t) ease-in-out var(--d) infinite; }
  .badge img { translate:var(--ix, 0px) var(--iy, 0px); transition:translate .45s cubic-bezier(.2,.8,.2,1); }
  .badge:nth-of-type(1) { --in:.25s; --ox:270%; --oy:185%; }
  .badge:nth-of-type(2) { --in:.4s; --ox:-235%; --oy:270%; }
  .badge:nth-of-type(3) { --in:.55s; --ox:330%; --oy:30%; }
  .badge:nth-of-type(4) { --in:.7s; --ox:-270%; --oy:70%; }
  @keyframes badge-in { from { translate:var(--ox) var(--oy); scale:.55; } }
  @keyframes badge-show { from { opacity:0; z-index:0; } 25% { opacity:1; } 75% { z-index:0; } 76% { z-index:2; } }
</style>
