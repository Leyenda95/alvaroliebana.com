---
// Página de presentación: cálida y juguetona, con paleta propia sacada de las fotos
// (azul cobalto del escenario y ocre de la madera).
import LandingLayout from '../layouts/LandingLayout.astro';
import T from '../components/T.astro';
import CvMenu from '../components/CvMenu.astro';
import { about, blog, contact, hero, links, nav, path, posts, work } from '../data/landing.js';

const logos = [
  { name: 'Aegis', src: '/img/logos/aegis.webp', href: 'https://aegis-midnight.vercel.app/' },
  { name: 'Gaia', src: '/img/logos/gaia.webp', href: 'https://tricubo.tech/gaia' },
  { name: 'SnowPDF', src: '/img/logos/snowpdf.webp', href: 'https://github.com/Leyenda95/snowpdf' },
  { name: 'Project Catalyst', src: '/img/logos/catalyst.svg', href: 'https://projectcatalyst.io/' },
];
const fonts = 'https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Geist+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600&display=swap';
const ticker = ['Midnight', 'Compact', 'Zero-knowledge', 'Algorand', 'Cardano', 'Solidity', 'Notion', 'TypeScript', 'Python', 'C/C++', 'Node.js', 'ClickUp', 'React', 'React Native', 'Docker', 'GitHub'];
const icons = {
  cap: '<path d="m2 9 10-5 10 5-10 5z"/><path d="M6 11.5V16c2 2.2 10 2.2 12 0v-4.5"/>',
  net: '<circle cx="12" cy="5" r="2.5"/><circle cx="5" cy="19" r="2.5"/><circle cx="19" cy="19" r="2.5"/><path d="M12 7.5V12m0 0-5.5 5M12 12l5.5 5"/>',
  wave: '<path d="M2 12h3l2-6 3 13 3-16 3 12 2-3h4"/>',
  buoy: '<path d="M12 3v5M8 8h8l2 8H6z"/><path d="M3 19.5c2 0 2 1.5 4.5 1.5S10 19.5 12 19.5s2 1.5 4.5 1.5 2.5-1.5 4.5-1.5"/>',
  receipt: '<path d="M6 3h12v18l-2-1.5-2 1.5-2-1.5-2 1.5-2-1.5L6 21z"/><path d="M9 8h6M9 12h6"/>',
  check: '<path d="M6 3h12v18H6z"/><path d="m9 12 2 2 4-4"/>',
  shield: '<path d="m12 3 8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="m9 12 2 2 4-4"/>',
};
---
<LandingLayout fonts={fonts}>
  <header class="hero">
    <nav class="top wrap">
      <a class="logo" href="/">Álvaro Liébana</a>
      <div class="navlinks">{nav.map((n) => <a href={n.href}><T t={n.label} /></a>)}</div>
    </nav>
    <div class="hero-grid wrap">
      <div>
        <T class="sticker" t={hero.status} />
        <h1 data-en="Hi, I’m Álvaro.">Hola, soy Álvaro.</h1>
        <T as="p" class="role" t={hero.role} />
        <T as="p" class="intro" t={hero.intro} />
        <div class="cta">
          <a class="btn solid" href="#work"><T t={hero.seeWork} /></a>
          <CvMenu class="btn-menu" />
          <a class="btn" href="#contact"><T t={hero.contact} /></a>
        </div>
      </div>
      <figure class="hero-photo">
        <img src="/img/talk-cutout.webp" width="810" height="1212" alt="Álvaro dando una charla" data-en-alt="Álvaro giving a talk" />
        {logos.map((l) => <a class="badge" href={l.href} target="_blank" rel="noopener" title={l.name}><img src={l.src} alt={l.name} /></a>)}
      </figure>
    </div>
    <div class="ticker" aria-hidden="true">
      <div>{[...ticker, ...ticker].map((x) => <span>{x}</span>)}</div>
    </div>
  </header>

  <main>
    <section id="about" class="wrap about">
      <div>
        <T as="h2" t={about.title} />
        {about.paragraphs.map((p) => <T as="p" t={p} />)}
      </div>
      <img src="/img/stage-gesture.webp" width="1400" height="933" loading="lazy" alt="Álvaro explicando una diapositiva en un escenario" data-en-alt="Álvaro explaining a slide on stage" />
      <ul class="pillars">
        {about.pillars.map((p) => (
          <li><T as="h3" t={p.title} /><T as="p" t={p.text} /></li>
        ))}
      </ul>
    </section>

    <section id="work" class="wrap">
      <T as="h2" t={work.title} />
      <div class="cards">
        {work.items.map((w) => (
          <article class="card">
            <div class="card-top"><h3>{w.name}</h3><span class="when">{w.when}</span></div>
            <T as="p" class="card-role" t={w.role} />
            <T as="p" t={w.text} />
            <div class="tags">{w.tags.map((t) => (Array.isArray(t) ? <T t={t} /> : <span>{t}</span>))}</div>
            {w.link && <a class="more" href={w.link.href} target="_blank" rel="noopener"><T t={w.link.label} /> ↗</a>}
          </article>
        ))}
      </div>
    </section>

    <section id="path" class="path">
      <div class="wrap">
        <T as="h2" t={path.title} />
        <T as="p" class="path-sub" t={path.sub} />
        <div class="route" id="route">
          <svg class="route-line" aria-hidden="true"><path class="road" /><path class="trail" /></svg>
          <ol>
            {path.items.map((p) => (
              <li class="stage">
                <span class="stop"><svg viewBox="0 0 24 24" aria-hidden="true"><Fragment set:html={icons[p.icon]} /></svg></span>
                <article class="stage-card">
                  {Array.isArray(p.when) ? <T class="stage-when" t={p.when} /> : <span class="stage-when">{p.when}</span>}
                  <T as="h3" t={p.org} />
                  <T as="p" class="stage-role" t={p.role} />
                  <T as="p" t={p.text} />
                </article>
              </li>
            ))}
          </ol>
        </div>
        <a class="path-more" href="/cv"><T t={path.more} /> →</a>
      </div>
      <script is:inline>
        // Camino de la trayectoria: une las paradas con una curva y la pinta según se hace scroll
        (() => {
          const route = document.getElementById('route');
          const svg = route.querySelector('.route-line');
          const [road, trail] = svg.querySelectorAll('path');
          const stops = [...route.querySelectorAll('.stop')];
          let points = [], lengths = [], total = 0, queued = false;
          let at = -1, goal = -1, anim = null; // parada actual, parada a la que hay que llegar y tramo en curso
          const lengthAt = (i) => (i < 0 ? 0 : lengths[i]);
          const setDrawn = (len) => { trail.style.strokeDashoffset = total - len; };

          function arrive(stop) {
            stop.classList.remove('flash');
            void stop.offsetWidth; // reinicia el destello si ya se había visto
            stop.classList.add('passed', 'flash');
          }
          // Recorre un tramo cada vez; si faltan varios, los encadena más deprisa
          function step() {
            if (anim || at === goal) return;
            const up = goal < at;
            const next = up ? at - 1 : at + 1;
            const left = Math.abs(goal - at);
            if (up) stops[at].classList.remove('passed', 'flash');
            // Al bajar, el tramo acaba en el borde del círculo: lo que queda va oculto debajo
            const edge = up ? lengthAt(next) : Math.max(lengthAt(at), lengthAt(next) - stops[next].offsetWidth / 2);
            const from = total - lengthAt(at), to = total - edge;
            const duration = from === to ? 0 : Math.max(up ? 200 : 500, (up ? 600 : 1600) / left);
            anim = trail.animate({ strokeDashoffset: [`${from}px`, `${to}px`] }, { duration, easing: up ? 'ease-in-out' : 'cubic-bezier(.35,0,.75,.75)' });
            anim.onfinish = () => {
              anim = null;
              at = next;
              setDrawn(lengthAt(at));
              if (!up) arrive(stops[at]);
              step();
            };
          }
          function paint() {
            queued = false;
            const target = innerHeight * 0.65 - route.getBoundingClientRect().top; // hasta dónde debe llegar el camino
            goal = points.reduce((last, p, i) => (p.y <= target ? i : last), -1);
            step();
          }
          function draw() {
            if (anim) { anim.onfinish = null; anim.cancel(); anim = null; }
            const box = route.getBoundingClientRect();
            points = stops.map((s) => {
              const r = s.getBoundingClientRect();
              return { x: r.left + r.width / 2 - box.left, y: r.top + r.height / 2 - box.top };
            });
            const parts = points.map((p, i) => {
              if (!i) return `M${p.x} ${p.y}`;
              const q = points[i - 1], mid = (q.y + p.y) / 2;
              return `C${q.x} ${mid} ${p.x} ${mid} ${p.x} ${p.y}`;
            });
            // Longitud de la curva hasta cada parada
            lengths = parts.map((_, i) => {
              trail.setAttribute('d', parts.slice(0, i + 1).join(''));
              return trail.getTotalLength();
            });
            const d = parts.join('');
            svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
            road.setAttribute('d', d);
            trail.setAttribute('d', d);
            total = trail.getTotalLength();
            trail.style.strokeDasharray = total;
            setDrawn(lengthAt(at));
            paint();
          }
          addEventListener('scroll', () => {
            if (!queued) { queued = true; requestAnimationFrame(paint); }
          }, { passive: true });
          new ResizeObserver(draw).observe(route); // cubre el cambio de idioma y la carga de fuentes
        })();
      </script>
    </section>

    <section id="blog" class="wrap">
      <div class="head-row">
        <T as="h2" t={blog.title} />
        <a class="more" href="/blog" data-href-es="/es/blog" data-href-en="/blog"><T t={blog.all} /> →</a>
      </div>
      <T as="p" class="blog-sub" t={blog.sub} />
      <ul class="posts">
        {posts.slice(0, 4).map((p) => (
          <li>
            <a href={`/blog/${p.slug}`} data-href-es={`/es/blog/${p.slug}`} data-href-en={`/blog/${p.slug}`}>
              <T class="p-title" t={p.title} />
              <time>{p.date}</time>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section id="contact" class="contact">
      <div class="wrap">
        <T as="h2" t={contact.title} />
        <T as="p" t={contact.text} />
        <a class="mail" href={`mailto:${links.email}`}>{links.email}</a>
        <div class="socials">
          <a href={links.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
          <a href={links.github} target="_blank" rel="noopener">GitHub ↗</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="wrap">Álvaro Liébana Carrascosa · {new Date().getFullYear()}</footer>
</LandingLayout>

<style is:global>
  body {
    --cobalt:#123f9c; --cobalt-deep:#0c2c70; --ochre:#e8b04a; --paper:#f7f1e5; --card:#fffdf8; --leaf:#2f6b4f; --rust:#c9562c; --night:#10204a;
    /* Colores de los selectores comunes */
    --surface:#fffdf8; --ink:var(--night); --muted:#55608a; --line:#d9cfb9; --accent:var(--cobalt); --shadow:0 1px 2px rgba(0,0,0,.12); color-scheme:light;
    /* Desplegable del CV */
    --menu-bg:var(--card); --menu-ink:var(--night); --menu-border:2px solid var(--night); --menu-radius:14px; --menu-shadow:5px 5px 0 var(--night); --menu-hover:color-mix(in srgb,var(--ochre) 35%,transparent);
    margin:0; background:var(--paper); color:var(--night); font:400 17px/1.65 "Instrument Sans", system-ui, sans-serif; -webkit-font-smoothing:antialiased; overflow-x:hidden;
  }
  .wrap { width:min(1120px, 100% - 40px); margin-inline:auto; }
  a { color:inherit; }
  h1, h2, h3 { font-family:"Bricolage Grotesque", system-ui, sans-serif; letter-spacing:-.025em; margin:0; }
  h2 { font-size:clamp(36px, 5.5vw, 60px); font-weight:800; line-height:1.05; margin-bottom:28px; }
  section.wrap { padding-block:clamp(56px, 8vw, 96px); scroll-margin-top:16px; }
  :focus-visible { outline:3px solid var(--rust); outline-offset:2px; }

  /* Portada */
  .hero { background:var(--cobalt); color:#fff; }
  .top { display:flex; flex-wrap:wrap; align-items:center; gap:12px 28px; padding-block:22px; padding-right:130px; }
  .logo { font:700 19px/1 "Bricolage Grotesque", sans-serif; text-decoration:none; }
  .navlinks { display:flex; flex-wrap:wrap; gap:6px 18px; font-size:15px; }
  .navlinks a { text-decoration:none; opacity:.85; }
  .navlinks a:hover { opacity:1; text-decoration:underline; text-decoration-color:var(--ochre); text-decoration-thickness:2px; text-underline-offset:4px; }
  .hero-grid { display:grid; grid-template-columns:minmax(0,1.25fr) minmax(0,.75fr); gap:48px; align-items:center; padding-block:clamp(28px, 5vw, 64px) clamp(48px, 6vw, 80px); }
  .sticker { display:inline-block; background:var(--ochre); color:var(--night); font-weight:600; font-size:14px; padding:6px 14px; border-radius:999px; transform:rotate(-2deg); }
  h1 { font-size:clamp(56px, 10vw, 118px); font-weight:800; line-height:.98; margin:20px 0 18px; }
  .role { font:600 clamp(19px, 2.2vw, 24px)/1.3 "Bricolage Grotesque", sans-serif; color:var(--ochre); margin:0 0 14px; }
  .intro { max-width:54ch; margin:0 0 28px; font-size:18px; }
  .cta { display:flex; flex-wrap:wrap; gap:12px; }
  .btn, .btn-menu summary { display:inline-flex; align-items:center; font:600 16px/1 "Instrument Sans", sans-serif; padding:14px 22px; border-radius:999px; border:2px solid #fff; color:#fff; text-decoration:none; background:transparent; transition:transform .16s ease, box-shadow .16s ease; }
  .btn.solid { background:var(--ochre); border-color:var(--ochre); color:var(--night); }
  .btn:hover, .btn-menu summary:hover { transform:translate(-2px,-2px); box-shadow:4px 4px 0 var(--cobalt-deep); }
  .ticker { border-top:2px solid rgba(255,255,255,.25); background:var(--cobalt-deep); overflow:hidden; padding-block:12px; }
  .ticker > div { display:flex; width:max-content; animation:slide 48s linear infinite; font:500 14px/1 "Geist Mono", monospace; }
  .ticker span { padding-inline:22px; white-space:nowrap; }
  .ticker span::after { content:"✦"; margin-left:44px; color:var(--ochre); }
  .ticker:hover > div { animation-play-state:paused; }
  @keyframes slide { to { transform:translateX(-50%); } }
  @media (max-width:820px) { .hero-grid { grid-template-columns:minmax(0,1fr); } .top { padding-right:0; padding-top:64px; } }

  /* Sobre mí */
  .about { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:40px 56px; align-items:center; }
  .about p { margin:0 0 16px; max-width:60ch; }
  .about > img { display:block; width:100%; height:auto; border-radius:22px; border:3px solid var(--night); box-shadow:10px 10px 0 var(--leaf); transform:rotate(-1.2deg); }
  .pillars { grid-column:1 / -1; list-style:none; margin:16px 0 0; padding:0; display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); gap:18px; }
  .pillars li { padding:22px; border-radius:20px; border:2px solid var(--night); }
  .pillars li:nth-child(1) { background:var(--ochre); transform:rotate(-.8deg); }
  .pillars li:nth-child(2) { background:#bcd7c6; transform:rotate(.6deg); }
  .pillars li:nth-child(3) { background:#f1b99f; transform:rotate(-.4deg); }
  .pillars h3 { font-size:24px; font-weight:800; margin-bottom:6px; }
  .pillars p { margin:0; font-size:16px; line-height:1.5; }
  @media (max-width:820px) { .about, .pillars { grid-template-columns:minmax(0,1fr); } }

  /* Proyectos */
  .cards { display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); gap:22px; align-items:start; }
  .card { background:var(--card); border:2px solid var(--night); border-radius:20px; padding:24px; box-shadow:7px 7px 0 var(--cobalt); transition:transform .18s ease, box-shadow .18s ease; display:flex; flex-direction:column; gap:10px; }
  .card:nth-child(2) { box-shadow:7px 7px 0 var(--rust); margin-top:28px; }
  .card:nth-child(3) { box-shadow:7px 7px 0 var(--leaf); margin-top:56px; }
  .card:hover { transform:translate(-2px,-3px) rotate(-.6deg); }
  .card-top { display:flex; justify-content:space-between; align-items:baseline; gap:12px; flex-wrap:wrap; }
  .card h3 { font-size:30px; font-weight:800; line-height:1.1; }
  .when { font:500 13px/1 "Geist Mono", monospace; color:var(--muted); white-space:nowrap; }
  .card p { margin:0; font-size:16px; line-height:1.55; }
  .card .card-role { font-weight:600; }
  .tags { display:flex; flex-wrap:wrap; gap:6px; }
  .tags span { font:500 12.5px/1 "Geist Mono", monospace; padding:6px 9px; border-radius:999px; background:color-mix(in srgb,var(--ochre) 30%,transparent); }
  .more { font-weight:600; text-decoration-color:var(--rust); text-decoration-thickness:2px; text-underline-offset:4px; }
  @media (max-width:820px) { .cards { grid-template-columns:minmax(0,1fr); } .card:nth-child(n) { margin-top:0; } }

  /* Trayectoria: un camino que une las etapas y se pinta al hacer scroll */
  .path { background:var(--ochre); padding-block:clamp(56px, 8vw, 96px); scroll-margin-top:0; overflow:hidden; }
  .path h2 { margin-bottom:8px; }
  .path-sub { margin:0 0 clamp(32px, 5vw, 56px); font:600 clamp(19px, 2.4vw, 26px)/1.3 "Bricolage Grotesque", sans-serif; letter-spacing:-.015em; }
  .route { position:relative; }
  .route-line { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; overflow:visible; }
  .route-line path { fill:none; stroke-linecap:round; }
  .road { stroke:color-mix(in srgb,var(--night) 40%,transparent); stroke-width:3; stroke-dasharray:2 11; }
  .trail { stroke:var(--cobalt); stroke-width:6; }
  .route ol { position:relative; list-style:none; margin:0; padding:0; }
  .stage { display:grid; grid-template-columns:minmax(0,1fr) 84px minmax(0,1fr); align-items:center; }
  .stage + .stage { margin-top:-44px; }
  .stage:nth-child(odd) .stage-card { grid-column:1; grid-row:1; transform:rotate(-.7deg); }
  .stage:nth-child(even) .stage-card { grid-column:3; grid-row:1; transform:rotate(.7deg); }
  .stage .stop { grid-column:2; grid-row:1; justify-self:center; }
  .stage:nth-child(odd) .stop { margin-right:30px; }
  .stage:nth-child(even) .stop { margin-left:30px; }
  .stop { position:relative; z-index:1; display:grid; place-items:center; width:54px; height:54px; border-radius:50%; background:var(--card); color:var(--night); border:2px solid var(--night); transition:background .25s ease, color .25s ease, transform .25s cubic-bezier(.34,1.56,.64,1); }
  .stop.passed { background:var(--cobalt); color:#fff; transform:scale(1.12); }
  /* Destello al llegar: el círculo da un saltito y sale de él un anillo fino de luz */
  .stop::after { content:""; position:absolute; inset:-2px; border-radius:50%; pointer-events:none; opacity:0; }
  .stop.flash { animation:stop-pop .4s ease-out; }
  .stop.flash::after { animation:stop-flash .6s ease-out; }
  @keyframes stop-pop { 0% { transform:scale(1); } 45% { transform:scale(1.2); } 100% { transform:scale(1.12); } }
  @keyframes stop-flash { 0% { opacity:.75; transform:scale(1); box-shadow:0 0 8px 2px rgba(255,255,255,.8); } 100% { opacity:0; transform:scale(1.7); box-shadow:0 0 10px 3px rgba(255,255,255,0); } }
  .stop svg { width:26px; height:26px; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
  .stage-card { background:var(--card); border:2px solid var(--night); border-radius:20px; padding:20px 22px; box-shadow:6px 6px 0 var(--night); display:flex; flex-direction:column; gap:4px; transition:transform .18s ease; }
  .stage .stage-card:hover { transform:translate(-2px,-3px) rotate(0deg); }
  .stage-when { font:800 clamp(24px, 3vw, 32px)/1.1 "Bricolage Grotesque", sans-serif; letter-spacing:-.025em; color:var(--cobalt); }
  .stage-card h3 { font-size:19px; font-weight:700; letter-spacing:-.015em; line-height:1.25; margin-top:4px; }
  .stage-card p { margin:0; font-size:15.5px; line-height:1.5; }
  .stage-card .stage-role { font-weight:600; }
  /* La última parada es hoy */
  .stage:last-child .stage-card { background:var(--cobalt); color:#fff; }
  .stage:last-child .stage-when { color:var(--ochre); }
  .path-more { display:block; width:fit-content; margin:clamp(28px, 4vw, 44px) auto 0; font-weight:600; text-decoration-thickness:2px; text-underline-offset:4px; }
  @media (max-width:820px) {
    .stage { grid-template-columns:54px minmax(0,1fr); gap:14px; align-items:start; }
    .stage + .stage { margin-top:22px; }
    .stage:nth-child(n) .stop { grid-column:1; justify-self:start; margin:14px 0 0; }
    .stage:nth-child(n) .stage-card { grid-column:2; transform:none; }
  }

  /* Blog */
  .head-row { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:baseline; gap:12px; }
  .head-row h2 { margin-bottom:0; }
  .blog-sub { margin:8px 0 24px; color:var(--muted); }
  .posts { list-style:none; margin:0; padding:0; border-top:2px solid var(--night); }
  .posts li { border-bottom:2px solid var(--night); }
  .posts a { display:flex; justify-content:space-between; align-items:baseline; gap:8px 24px; flex-wrap:wrap; padding:20px 4px; text-decoration:none; transition:padding .18s ease, background .18s ease; }
  .posts a:hover { background:color-mix(in srgb,var(--ochre) 35%,transparent); padding-inline:16px; }
  .p-title { font:700 clamp(19px, 2.4vw, 24px)/1.25 "Bricolage Grotesque", sans-serif; letter-spacing:-.015em; flex:1 1 320px; }
  .posts time { font:500 13px/1 "Geist Mono", monospace; color:var(--muted); }

  /* Contacto */
  .contact { background:var(--cobalt); color:#fff; padding-block:clamp(64px, 9vw, 110px); }
  .contact p { max-width:56ch; margin:0 0 26px; font-size:18px; }
