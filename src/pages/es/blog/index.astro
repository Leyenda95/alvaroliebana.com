---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import PostList from '../../../layouts/PostList.astro';

// Cada archivo .md de esta carpeta es un artículo en español
const posts = Object.values(import.meta.glob('./*.md', { eager: true })) as any[];
---
<BlogLayout title="Blog · Álvaro Liébana" description="Notas sobre privacidad, blockchain y construcción de producto." lang="es" altHref="/blog">
  <PostList posts={posts} lang="es" />
</BlogLayout>
